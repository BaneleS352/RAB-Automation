# ===========================================
# RAB Automation Service - Environment Config
# ===========================================

APP_NAME=rab-automation
APP_ENV=local
LOG_LEVEL=INFO

# Optional: override SQLite database file location
# DATABASE_PATH=

# Required: URL configured in Jira for webhook delivery
JIRA_WEBHOOK_URL=http://localhost:8000/webhooks/jira

# Jira API
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=automation.user@company.com
JIRA_API_TOKEN=replace_me

# Jira project
JIRA_PROJECT_KEY=

# Jira custom field IDs (map logical field names to Jira custom field IDs)
# When empty, validator falls back to parsing the Jira description RAB block (populated by populate_jira.py) — no longer blank.
# Set these to customfield IDs to use native Jira fields instead of description fallback:
#   Jira → Project Settings → Fields → Custom fields → copy ID (customfield_12345)
#   or use a standard field like 'environment' (already default for ENVIRONMENT)
JIRA_FIELD_PR_LINK=
JIRA_FIELD_PIPELINE_LINK=
JIRA_FIELD_RAB_APPROVER=
JIRA_FIELD_DEVELOPER=
JIRA_FIELD_TEAM_LEAD=
JIRA_FIELD_PM=
JIRA_FIELD_QA=
JIRA_FIELD_ENVIRONMENT=environment
JIRA_FIELD_ROLLBACK_DETAILS=
JIRA_FIELD_DATE_TIME=

# Jira workflow transition IDs
JIRA_TRANSITION_VALIDATE=
JIRA_TRANSITION_REQUEST_APPROVAL=
JIRA_TRANSITION_APPROVE=
JIRA_TRANSITION_REJECT=

# Optional: Azure Key Vault for secret resolution (JIRA_API_TOKEN, ACCESS_TOKEN)
# AZURE_VAULT_URL=https://your-vault.vault.azure.net/

# Shared secret. Required outside local/test environments.
# ACCESS_TOKEN=replace_me

# Demo and test UI are enabled automatically only in local/test environments.
# Set explicitly when needed in another environment.
# ENABLE_DEMO=false
# ENABLE_TEST_UI=false
